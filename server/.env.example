# Copy to .env and adjust. The app connects as the NON-superuser role "energy_app" (created by the migration runner).
# Owner URL = a PostgreSQL superuser (e.g. postgres): it runs migrations/seed and owns the tables and auth functions.
DATABASE_URL=postgres://energy_app:energy_app@localhost:5432/energy_audit
OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/energy_audit
APP_DB_PASSWORD=energy_app

# Separate database used by `npm test` (create it first: createdb energy_audit_test)
TEST_DATABASE_URL=postgres://energy_app:energy_app@localhost:5432/energy_audit_test
TEST_OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/energy_audit_test

JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
UPLOAD_DIR=./uploads

# Cookie settings (COOKIE_SECURE=true only when served over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_EXPIRES_HOURS=8

# Business constants
ANOMALY_THRESHOLD=0.30
LOGIN_RATE_MAX=10
