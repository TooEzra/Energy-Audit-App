# Copy to .env and adjust.
# MongoDB: local install (mongodb://127.0.0.1:27017) or an Atlas connection string (mongodb+srv://user:pass@cluster/...).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=energy_audit

# `npm test` uses a separate database and wipes it - never point this at real data.
TEST_MONGODB_DB=energy_audit_test

JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
UPLOAD_DIR=./uploads

# Cookie settings (COOKIE_SECURE=true only when served over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_EXPIRES_HOURS=8

# Business constants
ANOMALY_THRESHOLD=0.30
LOGIN_RATE_MAX=10
